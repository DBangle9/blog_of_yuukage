{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
{{- $items = $items | append (dict "title" .Title "url" .RelPermalink "description" (.Description | default (.Summary | plainify)) "content" .Plain "tags" (.Params.tags | default slice) "date" (.Date.Format "2006.01.02")) -}}
{{- end -}}
{{- $items | jsonify -}}
